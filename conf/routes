# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# Home page
GET     /                                       Application.index
GET     /sobre                                  Application.sobre
GET     /top-artistas                           Application.artistas

GET     /a/{id}                                 Artistas.detalhar

GET     /auth/login                             Usuarios.loginForm
GET     /auth/cadastro                          Usuarios.cadastroForm
GET     /auth/confirmacao                       Usuarios.confirmacao
GET     /auth/cadastrar                         Usuarios.cadastrar
GET     /user/{id}                            Usuarios.perfil


GET     /search                                 Musicas.findByName
GET     /musicas                                Musicas.listar
GET     /musicas/form                           Musicas.form
GET     /musica/{id}                            Musicas.detalhar
GET     /musica/{id}/editar                     Musicas.editar






# Ignore favicon requests
GET     /favicon.ico                            404

# Map static resources from the /app/public folder to the /public path
GET     /public/                                staticDir:public

# Catch all
*       /{controller}/{action}                  {controller}.{action}
